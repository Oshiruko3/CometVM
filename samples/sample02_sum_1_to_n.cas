; ====================================================================
; 学習用サンプル 02: 1からNまでの和を計算 (1 + 2 + ... + N)
; 内容: ループ処理と加算演算（ADDA）の基本パターンです。
; 入力: N = 100
; 出力: GR0 = 5050
; ====================================================================
SAMPLE02 START
         LD      GR1, N          ; カウンタ GR1 = N (100)
         LAD     GR0, 0          ; 合計値 GR0 = 0

LOOP     ADDA    GR0, GR1        ; 合計に GR1 を足す
         SUBA    GR1, ONE        ; カウンタを 1 減らす
         JNZ     LOOP            ; カウンタが 0 でなければループ継続

         ; 計算結果 GR0 (5050) が求まりました
         RET

N        DC      100
ONE      DC      1
         END
