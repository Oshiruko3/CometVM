; ====================================================================
; 学習用サンプル 05: ナル終端文字列の長さカウント
; 内容: 0 (ナル文字) で終わる文字列の長さをカウントします。
; 出力: GR0 = 文字列長 (12)
; ====================================================================
SAMPLE05 START
         LAD     GR1, 0          ; インデックス 兼 カウンタ GR1 = 0

LOOP     LD      GR2, STR, GR1   ; GR2 = STR[GR1]
         CPA     GR2, ZERO       ; 0 (ナル文字) かチェック
         JZE     DONE            ; 0 なら終了

         LAD     GR1, 1, GR1     ; カウンタ ++
         JUMP    LOOP

DONE     LD      GR0, GR1        ; GR0 = 文字列長 (12)
         RET

STR      DC      'CometVM Test'
         DC      0               ; ナル終端文字
ZERO     DC      0
         END
